<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.banking.SignupController"
            prefWidth="800.0" prefHeight="700.0">
    <center>
        <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: linear-gradient(to bottom, #667eea 0%, #764ba2 100%);">
            <padding>
                <Insets bottom="40.0" top="10.0" />
            </padding>
            <children>
                <VBox alignment="CENTER" maxWidth="450.0" spacing="20.0"
                      style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 2);">
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="15.0" />
                    </padding>
                    <children>
                        <Label text="Create Account" textFill="#333333">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>
                        <VBox spacing="15.0">
                            <children>
                                <!-- First Name & Last Name Row -->
                                <HBox spacing="15.0">
                                    <children>
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="First Name *" textFill="#333333">
                                                    <font>
                                                        <Font name="System Bold" size="12.0" />
                                                    </font>
                                                </Label>
                                                <TextField fx:id="firstNameField" promptText="Enter first name"
                                                           style="-fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-padding: 12;">
                                                    <font>
                                                        <Font size="14.0" />
                                                    </font>
                                                </TextField>
                                            </children>
                                        </VBox>
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Last Name *" textFill="#333333">
                                                    <font>
                                                        <Font name="System Bold" size="12.0" />
                                                    </font>
                                                </Label>
                                                <TextField fx:id="lastNameField" promptText="Enter last name"
                                                           style="-fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-padding: 12;">
                                                    <font>
                                                        <Font size="14.0" />
                                                    </font>
                                                </TextField>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- Email -->
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Email Address *" textFill="#333333">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="emailField" promptText="Enter your email"
                                                   style="-fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-padding: 12;">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </TextField>
                                    </children>
                                </VBox>

                                <!-- Phone -->
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Phone Number *" textFill="#333333">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="phoneField" promptText="Enter phone number"
                                                   style="-fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-padding: 12;">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </TextField>
                                    </children>
                                </VBox>

                                <!-- Password -->
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Password *" textFill="#333333">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                        <PasswordField fx:id="passwordField" promptText="Create a password"
                                                       style="-fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-padding: 12;">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </PasswordField>
                                    </children>
                                </VBox>

                                <!-- Deposit & Account Type Row -->
                                <HBox spacing="15.0">
                                    <children>
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Initial Deposit Amount *" textFill="#333333">
                                                    <font>
                                                        <Font name="System Bold" size="12.0" />
                                                    </font>
                                                </Label>
                                                <TextField fx:id="initialDepositField"
                                                           promptText="Enter initial deposit (minimum $100)"
                                                           style="-fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-padding: 12;">
                                                    <font>
                                                        <Font size="14.0" />
                                                    </font>
                                                </TextField>
                                            </children>
                                        </VBox>
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Account Type *" textFill="#333333">
                                                    <font>
                                                        <Font name="System Bold" size="12.0" />
                                                    </font>
                                                </Label>
                                                <ComboBox fx:id="accountTypeCombo"
                                                          maxWidth="1.7976931348623157E308"
                                                          promptText="Select account type"
                                                          style="-fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8;">
                                                    <items>
                                                        <FXCollections fx:factory="observableArrayList">
                                                            <String fx:value="Current Account" />
                                                            <String fx:value="Savings Account" />
                                                        </FXCollections>
                                                    </items>
                                                </ComboBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <Button fx:id="createAccountButton" maxWidth="1.7976931348623157E308"
                                onAction="#handleSignup" prefHeight="45.0"
                                style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold;"
                                text="Create Account">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>

                        <HBox alignment="CENTER" spacing="5.0">
                            <children>
                                <Label text="Already have an account?" textFill="#666666">
                                    <font>
                                        <Font size="12.0" />
                                    </font>
                                </Label>
                                <Button fx:id="loginButton" onAction="#HandleLogin"
                                        style="-fx-background-color: transparent; -fx-text-fill: #667eea; -fx-underline: true;"
                                        text="Sign In">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>

                        <Label fx:id="errorLabel" textFill="#e74c3c" visible="false" wrapText="true">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>

                        <Label fx:id="successLabel" textFill="#27ae60" visible="false" wrapText="true">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>